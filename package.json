{
  "name": "fandomonium",
  "version": "1.9.0",
  "description": "Movie, TV and anime trivia party game for 2 to 4 teams on one screen",
  "main": "main.js",
  "scripts": {
    "web": "node build-web.js",
    "site": "node build-site.js",
    "start": "node build-web.js && electron .",
    "dist": "node build-web.js && electron-builder --win portable --x64 --publish never",
    "test": "node build-site.js && python3 test/e2e.py",
    "dist:mac": "node build-web.js && electron-builder --mac dmg --universal --publish never"
  },
  "keywords": [],
  "author": "Matthew",
  "license": "ISC",
  "devDependencies": {
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "aedes": "^1.2.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "mqtt": "^5.16.1",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.23.0"
  },
  "productName": "Fandomonium",
  "build": {
    "appId": "com.matthew.fandomonium",
    "productName": "Fandomonium",
    "copyright": "Fan-made trivia for game night",
    "files": [
      "main.js",
      "web/**",
      "icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "Fandomonium.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.trivia-games",
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": false,
      "minimumSystemVersion": "13.0"
    },
    "dmg": {
      "artifactName": "Fandomonium.dmg",
      "title": "Fandomonium",
      "iconSize": 110,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/matthewsleclair-hue/fandomonium.git"
  },
  "homepage": "https://matthewsleclair-hue.github.io/fandomonium/"
}
